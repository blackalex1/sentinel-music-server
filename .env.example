# Порт веб-сервера и API (по умолчанию 8000)
PORT=8000

# Локальный путь к вашей фонотеке на хост-машине (например: /mnt/download или C:/Music)
MUSIC_DIR=./music

# Каталоги для постоянных данных на хост-машине
DATA_DIR=./data
PGDATA_DIR=./pgdata
PLUGINS_DIR=./plugins

# Конфигурация PostgreSQL (pgvector)
POSTGRES_DB=music_db
POSTGRES_USER=music_user
POSTGRES_PASSWORD=your_secure_password_here

# Строка подключения к БД
# В Docker: используется имя контейнера 'postgres'
DATABASE_URL=postgresql://music_user:your_secure_password_here@postgres:5432/music_db

# Автосканирование новых файлов в фонотеке через Watchdog (true / false)
WATCHDOG_ENABLED=true
WATCHDOG_DEBOUNCE_SECONDS=2.0

# Дополнительные разрешенные CORS-источники (при необходимости кастомного домена / прокси)
# Клиенты Tauri Desktop (http://tauri.localhost, tauri://localhost), localhost и локальная сеть разрешены по умолчанию
# ALLOWED_ORIGINS=https://music.mydomain.com
