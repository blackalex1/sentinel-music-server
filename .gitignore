# ==========================================
# Переменные окружения и секреты
# ==========================================
.env
.env.*
!.env.example
*token*
*key*
*credentials*.txt

# ==========================================
# Приватные плагины и модули скачивания
# ==========================================
plugins/*
!plugins/.gitkeep
!plugins/*.example
!plugins/__init__.py
*downloader*
*.private.*
*.secret.*
*tracks*.txt
test_*.txt

# ==========================================
# Базы данных и файлы состояния
# ==========================================
*.db
*.sqlite
*.sqlite3
*.log
data/*
!data/.gitkeep
discovery_history.json
discovered_tracks_history.json
*progress*.json
master_config.json
pgdata/

# ==========================================
# Аудиофайлы и фонотека
# ==========================================
*.flac
*.mp3
*.m4a
*.wav
*.ogg
*.opus
*.lrc
!*.example.lrc
music/*
!music/.gitkeep

# ==========================================
# Python артефакты и окружение
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
pip-log.txt

# ==========================================
# Архивы и дампы
# ==========================================
*.tar.gz
*.zip
*.tar

# ==========================================
# Системные файлы
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
